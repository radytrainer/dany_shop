# Production settings for the EC2 server. On the server:
#   cp deploy/aws/env.production.example .env && nano .env
# Generate secrets ON THE SERVER, e.g.:  openssl rand -hex 32
# Never commit or upload the filled-in .env.

NODE_ENV=production

# ─── Site ────────────────────────────────────────────────────────────────────
DOMAIN=dany-meas.store
APP_URL=https://dany-meas.store
# Expiry notices for the HTTPS certificate.
LETSENCRYPT_EMAIL=

# ─── Database (container-internal; DATABASE_URL is built by docker-compose) ──
POSTGRES_USER=dany
POSTGRES_DB=dany_shop
# Letters and digits only:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Secrets ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 24
CRON_SECRET=

# Behind the bundled nginx: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=true

# ─── First admin account (created on first deploy; change the password after logging in) ──
SEED_ADMIN_EMAIL=
# At least 10 characters.
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

# ─── Images ─────────────────────────────────────────────────────────────────
# "local" keeps uploads in a Docker volume on this server (included in backups).
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dany-shop

# ─── Backups ────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
# Optional: S3 bucket for off-server copies (needs the IAM role in deploy/aws/iam-backup-policy.json).
BACKUP_S3_BUCKET=

DISABLE_RATE_LIMIT=false
