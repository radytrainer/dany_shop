{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME",
      "Condition": { "StringLike": { "s3:prefix": ["dany-shop/*"] } }
    },
    {
      "Sid": "WriteBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME/dany-shop/*"
    }
  ]
}
