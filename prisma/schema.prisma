// Dany Shop — fashion e-commerce data model.
// Money: Decimal(12,2) everywhere; never Float. All ids are UUIDs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  AWAITING_SELLER_CONFIRMATION
  CONFIRMED
  AWAITING_PAYMENT
  PAYMENT_RECEIVED
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum ContactChannel {
  TELEGRAM
  WHATSAPP
  MESSENGER
}

/// Where the order's stock currently stands.
enum StockState {
  RESERVED // held for the order, not yet removed from on-hand stock
  RELEASED // reservation expired or order cancelled before deduction
  DEDUCTED // permanently removed from on-hand stock
  RESTOCKED // deducted then returned (cancelled after deduction)
}

/// Order status at which reserved stock is permanently deducted.
enum StockDeductionPoint {
  CONFIRMED
  PAYMENT_RECEIVED
  SHIPPED
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  RESERVE
  RELEASE
  DEDUCT
  RESTOCK
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  ALL
  CATEGORY
  PRODUCT
}

/// Condition grade for second-hand (pre-loved) items. Null = brand new stock.
enum ItemCondition {
  NEW_WITH_TAGS
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum BannerPlacement {
  HERO
  PROMO
  EDITORIAL
}

// ───────────────────────────── Users & auth ─────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  customerProfile CustomerProfile?
  addresses       Address[]
  orders          Order[]
  cart            Cart?
  wishlist        Wishlist?
  reviews         Review[]
  activityLogs    AdminActivityLog[]
  statusChanges   OrderStatusHistory[]
  inventoryMoves  InventoryMovement[]

  @@index([role])
}

/// Session id is the SHA-256 hash of the cookie token; the raw token is never stored.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CustomerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  telegramUsername String?
  preferredLocale  String   @default("en")
  newsletter       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String?
  fullName    String
  phone       String
  province    String
  district    String
  commune     String
  addressLine String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  bannerUrl   String?
  parentId    String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  products     Product[]
  translations CategoryTranslation[]
  promotions   Promotion[]
  coupons      Coupon[]

  @@index([parentId, sortOrder])
  @@index([isActive])
}

model CategoryTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @db.Uuid
  locale      String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Size {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  sortOrder    Int     @default(0)
  /// { "km": { "name": "…" } }
  translations Json    @default("{}")

  variants ProductVariant[]
}

model Color {
  id           String @id @default(uuid()) @db.Uuid
  name         String @unique
  hex          String
  sortOrder    Int    @default(0)
  /// { "km": { "name": "…" } }
  translations Json   @default("{}")

  variants ProductVariant[]
  images   ProductImage[]
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  sku               String        @unique
  name              String
  shortDescription  String?
  description       String
  categoryId        String        @db.Uuid
  brand             String?
  price             Decimal       @db.Decimal(12, 2)
  salePrice         Decimal?      @db.Decimal(12, 2)
  /// Denormalised COALESCE(salePrice, price) for price sorting/filtering. Kept in sync by the product service.
  sortPrice         Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("USD") @db.VarChar(3)
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  isNewArrival      Boolean       @default(false)
  isBestSeller      Boolean       @default(false)
  tags              String[]      @default([])
  /// Units sold across completed/active orders; drives "Best selling" sort.
  soldCount         Int           @default(0)
  /// Product page views; drives "Popularity" sort.
  viewCount         Int           @default(0)
  lowStockThreshold Int           @default(5)
  /// Set for second-hand items; null for new stock.
  condition         ItemCondition?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  variants     ProductVariant[]
  translations ProductTranslation[]
  collections  CollectionProduct[]
  wishlisted   WishlistItem[]
  reviews      Review[]
  orderItems   OrderItem[]
  promotions   Promotion[]
  coupons      Coupon[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([soldCount])
  @@index([sortPrice])
  @@index([viewCount])
  @@index([tags], type: Gin)
}

model ProductTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @db.Uuid
  locale           String
  name             String
  shortDescription String?
  description      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  url        String
  /// Storage key (local path or Cloudinary public id) for deletion.
  storageKey String?
  alt        String?
  colorId    String?  @db.Uuid
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sku           String   @unique
  sizeId        String   @db.Uuid
  colorId       String   @db.Uuid
  priceOverride Decimal? @db.Decimal(12, 2)
  /// On-hand units.
  stock         Int      @default(0)
  /// Units held by open orders. Available = stock - reserved.
  reserved      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       Size                @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color      Color               @relation(fields: [colorId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, sizeId, colorId])
  @@index([productId])
}

model Collection {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  imageUrl     String?
  bannerUrl    String?
  /// { "km": { "name": "...", "description": "..." } }
  translations Json     @default("{}")
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products CollectionProduct[]

  @@index([isActive, sortOrder])
}

model CollectionProduct {
  collectionId String @db.Uuid
  productId    String @db.Uuid
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  userId     String   @db.Uuid
  rating     Int
  title      String?
  body       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved])
}

// ───────────────────────────── Cart & wishlist ─────────────────────────────

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ───────────────────────────── Orders ─────────────────────────────

/// Per-year sequence for human-readable order numbers (ORD-2026-00001).
model OrderCounter {
  year  Int @id
  value Int @default(0)
}

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  orderNumber          String         @unique
  /// SHA-256 of the guest access token embedded in the confirmation URL.
  accessTokenHash      String
  userId               String?        @db.Uuid
  status               OrderStatus    @default(PENDING)
  paymentStatus        PaymentStatus  @default(UNPAID)
  paidAt               DateTime?
  paymentNote          String?
  contactChannel       ContactChannel
  messageOpenedAt      DateTime?
  locale               String         @default("en")

  // Customer snapshot
  customerName         String
  phone                String
  telegramUsername     String?
  email                String?
  province             String
  district             String
  commune              String
  addressLine          String
  deliveryNotes        String?

  // Delivery snapshot
  deliveryMethodId     String?        @db.Uuid
  deliveryMethodName   String

  // Totals snapshot (server-calculated)
  currency             String         @db.VarChar(3)
  subtotal             Decimal        @db.Decimal(12, 2)
  discountTotal        Decimal        @db.Decimal(12, 2)
  deliveryFee          Decimal        @db.Decimal(12, 2)
  taxTotal             Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal        @db.Decimal(12, 2)
  couponId             String?        @db.Uuid
  couponCode           String?

  // Inventory
  stockState           StockState     @default(RESERVED)
  reservationExpiresAt DateTime?

  // Fulfilment
  trackingNumber       String?
  internalNotes        String?
  cancelledAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryMethod DeliveryMethod?      @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  movements      InventoryMovement[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([phone])
  @@index([stockState, reservationExpiresAt])
}

/// Immutable snapshot of what was ordered, at the price at order time.
model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String? @db.Uuid
  variantId   String? @db.Uuid
  productName String
  productSlug String
  sku         String
  sizeName    String
  colorName   String
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?      @db.Uuid
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @db.Uuid
  type          InventoryMovementType
  /// Signed change applied to `stock` (on-hand).
  stockDelta    Int                   @default(0)
  /// Signed change applied to `reserved`.
  reservedDelta Int                   @default(0)
  stockAfter    Int
  reservedAfter Int
  reason        String?
  orderId       String?               @db.Uuid
  userId        String?               @db.Uuid
  createdAt     DateTime              @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

// ───────────────────────────── Promotions ─────────────────────────────

model Coupon {
  id             String        @id @default(uuid()) @db.Uuid
  /// Stored upper-case.
  code           String        @unique
  description    String?
  type           DiscountType
  value          Decimal       @db.Decimal(12, 2)
  scope          DiscountScope @default(ALL)
  minOrderAmount Decimal?      @db.Decimal(12, 2)
  maxDiscount    Decimal?      @db.Decimal(12, 2)
  startsAt       DateTime?
  expiresAt      DateTime?
  usageLimit     Int?
  usageCount     Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categories Category[]
  products   Product[]
  orders     Order[]
}

/// Automatic price reductions shown directly on product prices (no code needed).
model Promotion {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  type      DiscountType
  value     Decimal       @db.Decimal(12, 2)
  scope     DiscountScope @default(ALL)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  categories Category[]
  products   Product[]

  @@index([isActive])
}

// ───────────────────────────── Content & settings ─────────────────────────────

model Banner {
  id                 String          @id @default(uuid()) @db.Uuid
  placement          BannerPlacement
  title              String
  subtitle           String?
  description        String?
  ctaLabel           String?
  ctaHref            String?
  secondaryCtaLabel  String?
  secondaryCtaHref   String?
  imageUrl           String
  mobileImageUrl     String?
  /// { "km": { "title": "...", "subtitle": "...", ... } }
  translations       Json            @default("{}")
  sortOrder          Int             @default(0)
  isActive           Boolean         @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model DeliveryMethod {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  fee           Decimal  @db.Decimal(12, 2)
  /// Free delivery when subtotal (after discount) reaches this amount.
  freeOverAmount Decimal? @db.Decimal(12, 2)
  estimatedDays String?
  isPickup      Boolean  @default(false)
  translations  Json     @default("{}")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

/// Singleton row (id = "default").
model StoreSettings {
  id                   String              @id @default("default")
  storeName            String              @default("DANY")
  tagline              String?
  logoUrl              String?
  faviconUrl           String?
  currency             String              @default("USD") @db.VarChar(3)
  defaultLocale        String              @default("en")
  /// Fixed, admin-set rate for showing an approximate KHR total. Never auto-updated.
  khrExchangeRate      Decimal?            @db.Decimal(12, 2)
  showKhrEquivalent    Boolean             @default(false)

  telegramUsername     String?
  messengerUrl         String?
  whatsappNumber       String?
  defaultChannel       ContactChannel      @default(TELEGRAM)

  minOrderAmount       Decimal?            @db.Decimal(12, 2)
  taxEnabled           Boolean             @default(false)
  taxRate              Decimal             @default(0) @db.Decimal(5, 2)
  taxLabel             String              @default("VAT")

  reservationHours     Int                 @default(48)
  deductStockOn        StockDeductionPoint @default(CONFIRMED)
  lowStockThreshold    Int                 @default(5)

  contactEmail         String?
  contactPhone         String?
  address              String?
  socialLinks          Json                @default("{}")
  footerText           String?
  shippingInfo         String?
  sizeGuide            String?

  announcementActive   Boolean             @default(false)
  announcementText     String?
  announcementHref     String?
  /// { "km": { "announcementText": "...", "tagline": "...", "footerText": "...", ... } }
  translations         Json                @default("{}")
  /// Show the Collections menu link, pages and homepage section.
  showCollections      Boolean             @default(true)
  /// Ordered list of { key, enabled } for homepage sections.
  homepageSections     Json                @default("[]")
  /// [{ imageUrl, href }]
  socialGallery        Json                @default("[]")
  updatedAt            DateTime            @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

model AdminActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
