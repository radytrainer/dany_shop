# ─── Database ────────────────────────────────────────────────────────────────
# Local dev uses the docker-compose "db" service (port 5433 on Windows; 5432 elsewhere is fine).
POSTGRES_USER=dany
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dany_shop
POSTGRES_PORT=5433
DATABASE_URL="postgresql://dany:change-me@localhost:5433/dany_shop?schema=public"
# Separate database used only by integration tests (it is wiped by the tests).
DATABASE_URL_TEST="postgresql://dany:change-me@localhost:5433/dany_shop_test?schema=public"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL (used for absolute links in order messages, sitemap, CSRF origin check).
APP_URL="http://localhost:3000"
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
# Set to true when running behind the bundled Nginx reverse proxy (trust X-Forwarded-For).
TRUST_PROXY=false
# Shared secret for /api/cron/* endpoints (reservation expiry). Send as "Authorization: Bearer <secret>".
CRON_SECRET="replace-with-a-random-string"

# ─── Image storage ───────────────────────────────────────────────────────────
# "local" stores uploads on disk (mount a volume in production); "cloudinary" uses Cloudinary.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dany-shop

# ─── Seed ────────────────────────────────────────────────────────────────────
# First admin account created by `npm run db:seed` (password ≥ 10 chars). Change it after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Demo products are seeded automatically outside production. Never enable in production.
SEED_DEMO=false

# Local testing only (e2e). Ignored when NODE_ENV=production.
DISABLE_RATE_LIMIT=false

# ─── Deployment (docker compose --profile prod) ─────────────────────────────
# Public domain served by Nginx (TLS via Let's Encrypt).
DOMAIN=shop.example.com
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
